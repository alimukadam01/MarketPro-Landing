# Copy to `.env` and fill in. Vite exposes only VITE_-prefixed vars to the client.

# WhatsApp business number for the "WhatsApp pe baat karein" deep-link.
# Digits only, international format, NO '+', leading '0', or spaces.
# (Local 03313689402 → 923313689402.) Optional — the app already defaults to
# this number in code; set here only to override per environment.
VITE_WHATSAPP_NUMBER=923313689402

# Lead/contact POST endpoint. Optional — defaults in code to
# https://app.market-pro.pk/contact/. Override for staging or local testing.
# VITE_LEADS_ENDPOINT=http://127.0.0.1:8000/contact/
